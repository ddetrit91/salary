# База данных Turso (получите в дашборде https://turso.tech или через CLI: turso db show <db-name> --url)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Секрет для JWT токенов (сгенерируйте любую случайную строку)
JWT_SECRET=super-secret-production-key-change-me

# Логин и пароль первого администратора (по умолчанию: admin / admin123)
ADMIN_USERNAME=****
ADMIN_PASSWORD=****
